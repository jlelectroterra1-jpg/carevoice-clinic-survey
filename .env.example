# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Brevo (https://www.brevo.com) transactional email API key, used instead of
# raw SMTP since most PaaS free tiers (e.g. Render) block outbound SMTP ports.
BREVO_API_KEY=
FROM_EMAIL=
HEAD_OFFICE_EMAIL=

# Admin Console credentials & session management
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
SESSION_SECRET=arrie-nel-pharmacy-sunningdale-secret-key-32-chars!!

# Optional: an extra frontend origin allowed to call this API via CORS,
# beyond the GitHub Pages URL and localhost dev ports already allowed
# by default (see ALLOWED_ORIGINS in server.ts).
EXTRA_ALLOWED_ORIGIN=

